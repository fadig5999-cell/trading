<%- include("partials/header") %>
<section class="panel">
  <div class="panel-head">
    <h2>מלאי שיש ואבן</h2>
    <% if (user.role === "admin") { %>
      <a class="btn btn-primary" href="/inventory/new">הוסף סוג שיש</a>
    <% } %>
  </div>

  <form class="filters" method="get" action="/inventory">
    <label>חיפוש
      <input type="text" name="search" placeholder="חיפוש לפי שם" value="<%= filters.search %>" />
    </label>
    <label>צבע
      <select name="color">
        <option value="">הכל</option>
        <% options.colors.forEach((color) => { %>
          <option value="<%= color %>" <%= filters.color === color ? "selected" : "" %>><%= color %></option>
        <% }) %>
      </select>
    </label>
    <label>עובי
      <select name="thickness">
        <option value="">הכל</option>
        <% options.thicknesses.forEach((thickness) => { %>
          <option value="<%= thickness %>" <%= filters.thickness === thickness ? "selected" : "" %>><%= thickness %></option>
        <% }) %>
      </select>
    </label>
    <label>מיקום
      <select name="location">
        <option value="">הכל</option>
        <% options.locations.forEach((location) => { %>
          <option value="<%= location %>" <%= filters.location === location ? "selected" : "" %>><%= location %></option>
        <% }) %>
      </select>
    </label>
    <label>קטגוריה
      <select name="category">
        <option value="">הכל</option>
        <% options.categories.forEach((category) => { %>
          <option value="<%= category %>" <%= filters.category === category ? "selected" : "" %>><%= category %></option>
        <% }) %>
      </select>
    </label>
    <label>סטטוס
      <select name="stockState">
        <option value="">הכל</option>
        <option value="low" <%= filters.stockState === "low" ? "selected" : "" %>>מלאי נמוך</option>
        <option value="sold_out" <%= filters.stockState === "sold_out" ? "selected" : "" %>>אזל מהמלאי</option>
      </select>
    </label>
    <button class="btn btn-muted" type="submit">חיפוש</button>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>תמונה</th>
          <th>שם השיש</th>
          <th>מאפיינים</th>
          <th>כמות במלאי</th>
          <th>מחירים</th>
          <th>סטטוס</th>
          <th>פעולות</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach((item) => { %>
          <tr>
            <td>
              <% if (item.image_path) { %>
                <img class="thumb" src="<%= item.image_path %>" alt="<%= item.hebrew_name %>" />
              <% } else { %>
                <div class="thumb placeholder">ללא תמונה</div>
              <% } %>
            </td>
            <td>
              <strong><%= item.hebrew_name %></strong><br />
              <small><%= item.name %></small><br />
              <small><%= item.notes || "—" %></small>
            </td>
            <td>
              קטגוריה: <%= item.category %><br />
              צבע: <%= item.color %><br />
              עובי: <%= item.thickness %><br />
              גודל: <%= item.size %><br />
              מיקום: <%= item.location %>
            </td>
            <td><strong><%= item.quantity %></strong></td>
            <td>
              עלות: <%= item.cost_price ? Number(item.cost_price).toLocaleString("he-IL") : "—" %> <%= currency %><br />
              מכירה: <%= item.selling_price ? Number(item.selling_price).toLocaleString("he-IL") : "—" %> <%= currency %>
            </td>
            <td>
              <% if (item.status === "sold_out") { %>
                <span class="chip sold-out">אזל מהמלאי</span>
              <% } else if (item.status === "low_stock") { %>
                <span class="chip low-stock">מלאי נמוך</span>
              <% } else { %>
                <span class="chip in-stock">במלאי</span>
              <% } %>
            </td>
            <td class="actions-cell">
              <% if (user.role === "admin") { %>
                <form method="post" action="/inventory/<%= item.id %>/sell-one">
                  <button class="btn danger" type="submit">מכור לוח</button>
                </form>
                <form method="post" action="/inventory/<%= item.id %>/stock/add" class="inline-form">
                  <input type="number" min="1" name="amount" value="1" />
                  <button class="btn btn-muted" type="submit">הוסף מלאי</button>
                </form>
                <form method="post" action="/inventory/<%= item.id %>/stock/remove" class="inline-form">
                  <input type="number" min="1" name="amount" value="1" />
                  <button class="btn btn-muted" type="submit">הפחת מלאי</button>
                </form>
                <form method="post" action="/inventory/<%= item.id %>/stock/set" class="inline-form">
                  <input type="number" min="0" name="quantity" value="<%= item.quantity %>" />
                  <button class="btn btn-muted" type="submit">ערוך כמות</button>
                </form>
                <a class="btn btn-muted" href="/inventory/<%= item.id %>/edit">ערוך</a>
                <form method="post" action="/inventory/<%= item.id %>/delete" onsubmit="return confirm('למחוק את הפריט?');">
                  <button class="btn danger-outline" type="submit">מחק</button>
                </form>
              <% } else { %>
                <span class="chip">צפייה בלבד</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include("partials/footer") %>
