# Bybit credentials. Create these on Bybit testnet first.
# Never commit real API keys. Copy this file to .env locally and fill values there.
BYBIT_API_KEY=your_testnet_api_key_here
BYBIT_API_SECRET=your_testnet_api_secret_here

# Trading environment
TESTNET=true
PAPER_TRADING=true
SYMBOL=BTCUSDT
EXCHANGE=Bybit
CATEGORY=linear

# Strategy timeframes
ENTRY_INTERVAL=15
H1_INTERVAL=60
H4_INTERVAL=240
HISTORICAL_LIMIT=300

# Risk configuration
RISK_PER_TRADE_USD=10
TARGET_PROFIT_USD=50
MINIMUM_RR=3
MAX_TRADES_PER_DAY=2
MAX_DAILY_LOSS_USD=30
MAX_CONSECUTIVE_LOSSES=2
LEVERAGE=2
MAX_LEVERAGE=3

# Filters
USE_ATR_FILTER=true
ATR_PERIOD=14
USE_VOLUME_FILTER=true
USE_SESSION_FILTER=true
SESSION_START=07:00
SESSION_END=23:00
MAX_SPREAD_BPS=5
MAX_ATR_MULTIPLIER=2.5
MIN_ATR_PCT=0.0008
VOLUME_LOOKBACK=20
MIN_VOLUME_MULTIPLIER=0.8

# Direction toggles
ENABLE_LONG_TRADES=true
ENABLE_SHORT_TRADES=true

# Runtime
POLL_INTERVAL_SECONDS=60
JOURNAL_PATH=trade_journal.csv
LOG_LEVEL=INFO
