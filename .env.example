# Copy this file to .env and adjust values for production.

# Port the server listens on
PORT=3000

# Secret used to sign JWT session tokens. CHANGE THIS to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret-string

# Default admin account created on first run (only used if no users exist yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=מנהל המערכת

# Low-stock threshold: quantities below this number (and above 0) are flagged "מלאי נמוך"
LOW_STOCK_THRESHOLD=3

# Business name shown in the UI
BUSINESS_NAME=אולם תצוגת שיש
