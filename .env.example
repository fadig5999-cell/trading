# Exchange and environment
SYMBOL=BTCUSDT
EXCHANGE=Bybit
TESTNET=true
PAPER_TRADING=false
CATEGORY=linear

# Bybit API credentials. Use testnet keys first.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Risk model
RISK_PER_TRADE_USD=10
TARGET_PROFIT_USD=50
MINIMUM_RR=3
MAX_TRADES_PER_DAY=2
MAX_DAILY_LOSS_USD=30
MAX_CONSECUTIVE_LOSSES=2

# Filters
USE_ATR_FILTER=true
ATR_PERIOD=14
USE_VOLUME_FILTER=true
USE_SESSION_FILTER=true
SESSION_START=07:00
SESSION_END=23:00
MIN_ATR_PCT=0.0005
MAX_ATR_PCT=0.018
MAX_SPREAD_BPS=5
MIN_VOLUME_RATIO=0.80

# Direction and leverage
ENABLE_LONG_TRADES=true
ENABLE_SHORT_TRADES=true
LEVERAGE=2
MAX_LEVERAGE=5

# Timeframes and runtime
ENTRY_TIMEFRAME=15
H1_TIMEFRAME=60
H4_TIMEFRAME=240
DATA_LIMIT=300
LOOP_SECONDS=60
ORDER_TYPE=Market
POST_ONLY_LIMITS=false
SLIPPAGE_BUFFER_BPS=2

# Files
JOURNAL_PATH=trades_journal.csv
LOG_PATH=bot.log

# Required only if TESTNET=false
LIVE_TRADING_CONFIRMATION=
